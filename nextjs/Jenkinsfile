pipeline {
    agent any

    environment {
        DOCKERHUB_CRED = credentials('76588328-ef1c-45fe-aadf-7a77a4e40c95')
        IMAGE_NAME = "dyanle/vaoluoi-frontend"
        IMAGE_TAG = "latest" 
        IMAGE = "${IMAGE_NAME}:${IMAGE_TAG}"
        // Add deploy agent URL and token from Jenkins credentials or environment
        DEPLOY_AGENT_URL = "http://your-deploy-agent-host:5555/deploy" 
        DEPLOY_AGENT_TOKEN = "token1234" 
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'jenkins-test', url: 'https://github.com/luvteamdyan/vaoluoitv-demo.git'
            }
        }

        stage('Build and Push Docker Image') {
            agent {
                docker {
                    image 'docker:20.10.17'
                    args '-v /var/run/docker.sock:/var/run/docker.sock'
                }
            }
            steps {
                sh 'docker build -t $IMAGE -f nextjs/Dockerfile .'
                withCredentials([usernamePassword(credentialsId: '76588328-ef1c-45fe-aadf-7a77a4e40c95', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                    sh '''
                        echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin
                        docker push $IMAGE
                    '''
                }
            }
        }

        stage('Deploy via Agent') {
            steps {
                sh """
                curl -X POST ${DEPLOY_AGENT_URL} \\
                     -H "Content-Type: application/json" \\
                     -d '{
                           "stack": "vaoluoitv",
                           "service": "vaoluoi-frontend",
                           "image": "${IMAGE}",
                           "token": "${DEPLOY_AGENT_TOKEN}"
                         }'
                """
            }
        }
    }
}
