pipeline {
    agent any

    environment {
        DOCKERHUB_CRED = credentials('0db1c2ef-92e6-47cb-a06b-4abb9ce57383')
        IMAGE_NAME = "dyanle/vaoluoi-frontend"
        IMAGE_TAG = "latest" 
        IMAGE = "${IMAGE_NAME}:${IMAGE_TAG}"
        DEPLOY_AGENT_URL = "http://your-deploy-agent-host:5555/deploy" 
        DEPLOY_AGENT_TOKEN = "token1234" 
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'jenkins-test', url: 'https://github.com/luvteamdyan/vaoluoitv-demo.git'
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                sh """
                # Login to Docker Hub
                echo \$DOCKERHUB_CRED_PSW | docker login -u \$DOCKERHUB_CRED_USR --password-stdin
                
                # CD to nextjs and build
                cd nextjs
                docker build -t ${IMAGE} .
                
                # Push image
                docker push ${IMAGE}
                """
            }
        }

        stage('Deploy via Agent') {
            steps {
                sh """
                curl -X POST ${DEPLOY_AGENT_URL} \\
                     -H "Content-Type: application/json" \\
                     -d '{
                           "stack": "vaoluoitv",
                           "service": "vaoluoi-frontend",
                           "image": "${IMAGE}",
                           "token": "${DEPLOY_AGENT_TOKEN}"
                         }'
                """
            }
        }
    }
}