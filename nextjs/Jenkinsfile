pipeline {
    agent any

    environment {
        DOCKERHUB_CRED = credentials('76588328-ef1c-45fe-aadf-7a77a4e40c95')
        IMAGE_NAME = "dyanle/vaoluoi-frontend"
        IMAGE_TAG = "latest" 
        IMAGE = "${IMAGE_NAME}:${IMAGE_TAG}"
        // Add deploy agent URL and token from Jenkins credentials or environment
        DEPLOY_AGENT_URL = "http://your-deploy-agent-host:5555/deploy" 
        DEPLOY_AGENT_TOKEN = "token1234" 
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'jenkins-test', url: 'https://github.com/luvteamdyan/vaoluoitv-demo.git'
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    def dockerImage = docker.build("${IMAGE}", "-f nextjs/Dockerfile .")
                    docker.withRegistry('https://index.docker.io/v1/', '76588328-ef1c-45fe-aadf-7a77a4e40c95') {
                        dockerImage.push()
                    }
                }
            }
        }

        stage('Deploy via Agent') {
            steps {
                sh """
                curl -X POST ${DEPLOY_AGENT_URL} \\
                     -H "Content-Type: application/json" \\
                     -d '{
                           "stack": "vaoluoitv",
                           "service": "vaoluoi-frontend",
                           "image": "${IMAGE}",
                           "token": "${DEPLOY_AGENT_TOKEN}"
                         }'
                """
            }
        }
    }
}
