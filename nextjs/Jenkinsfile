pipeline {
    agent any

    environment {
        DOCKERHUB_CRED = credentials('0db1c2ef-92e6-47cb-a06b-4abb9ce57383')
        IMAGE_NAME = "dyanle/vaoluoi-frontend"
        IMAGE_TAG = "latest"
        IMAGE = "${IMAGE_NAME}:${IMAGE_TAG}"
        DEPLOY_AGENT_URL = "https://deploy-agent.vaoluoitv.com/deploy"
        DEPLOY_AGENT_TOKEN = "token1234"
        
        // Telegram Bot Configuration
        TELEGRAM_BOT_TOKEN = credentials('TELEGRAM_BOT_TOKEN') // Cần tạo credential trong Jenkins
        TELEGRAM_CHAT_ID = credentials('TELEGRAM_CHAT_ID')     // Cần tạo credential trong Jenkins
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'jenkins-test', url: 'https://github.com/luvteamdyan/vaoluoitv-demo.git'
            }
        }

                stage('Detect Changes') {
                        steps {
                                script {
                                        // capture changed files between HEAD and previous commit (or list files in initial commit)
                                        def changed = sh(returnStdout: true, script: '''
                                                if git rev-parse --verify HEAD^ >/dev/null 2>&1; then
                                                    git diff --name-only HEAD^ HEAD || true
                                                else
                                                    git show --name-only --pretty=format: HEAD || true
                                                fi
                                        ''').trim()

                                        if (changed) {
                                                // check if any changed path starts with nextjs/
                                                def hasNextjs = changed.split('\n').find { it?.trim()?.startsWith('nextjs/') }
                                                if (hasNextjs) {
                                                        echo "Changes detected in nextjs directory."
                                                        env.CHANGES_DETECTED = 'true'
                                                } else {
                                                        echo "No changes in nextjs directory."
                                                        env.CHANGES_DETECTED = 'false'
                                                }
                                        } else {
                                                echo "No changed files detected."
                                                env.CHANGES_DETECTED = 'false'
                                        }
                                }
                        }
                }

        stage('Build and Push Docker Image') {
            when {
                expression { return env.CHANGES_DETECTED == 'true' }
            }
            steps {
                script {
                    sh '''
                    set -euo pipefail
                    # Login to Docker Hub
                    echo "$DOCKERHUB_CRED_PSW" | docker login -u "$DOCKERHUB_CRED_USR" --password-stdin

                    # Build from nextjs directory
                    cd nextjs
                    docker build -t ${IMAGE} .

                    # Push image
                    docker push ${IMAGE}
                    '''
                    // mark success for deploy stage
                    env.BUILD_PUSH_OK = 'true'
                }
            }
        }

        stage('Deploy via Agent') {
            when {
                allOf {
                    expression { return env.CHANGES_DETECTED == 'true' }
                    expression { return env.BUILD_PUSH_OK == 'true' }
                }
            }
            steps {
                sh '''
                curl -X POST ${DEPLOY_AGENT_URL} \\
                     -H "Content-Type: application/json" \\
                     -d '{
                           "stack": "vaoluoitv",
                           "service": "vaoluoi-frontend",
                           "image": "${IMAGE}",
                           "token": "${DEPLOY_AGENT_TOKEN}"
                         }'
                '''
            }
        }
        
        stage('Notify Success') {
            when {
                allOf {
                    expression { return env.CHANGES_DETECTED == 'true' }
                    expression { return env.BUILD_PUSH_OK == 'true' }
                }
            }
            steps {
                script {
                    // Lấy thông tin commit
                    def commitAuthor = sh(returnStdout: true, script: 'git log -1 --pretty=format:"%an"').trim()
                    def commitMessage = sh(returnStdout: true, script: 'git log -1 --pretty=format:"%s"').trim()
                    
                    // Tính duration
                    def duration = currentBuild.durationString.replace(' and counting', '')
                    
                    def message = """
✅ *Build Thành Công*
📦 Project: vaoluoi-frontend
🔖 Branch: ${env.GIT_BRANCH}
🐳 Image: ${IMAGE}
� Commit by: ${commitAuthor}
� Commit message: ${commitMessage}
⏱ Duration: ${duration}
🕒 Time: ${new Date().format('dd/MM/yyyy HH:mm:ss')}
                    """.trim()
                    
                    sh """
                    curl -s -X POST https://api.telegram.org/bot\${TELEGRAM_BOT_TOKEN}/sendMessage \\
                         -d chat_id=\${TELEGRAM_CHAT_ID} \\
                         -d parse_mode=Markdown \\
                         -d text='${message}'
                    """
                }
            }
        }
    }

    post {
        always {
            script {
                echo "CHANGES_DETECTED=${env.CHANGES_DETECTED ?: 'unset'}"
                echo "BUILD_PUSH_OK=${env.BUILD_PUSH_OK ?: 'unset'}"
                
                // Cleanup: Remove dangling Docker images and containers
                echo "Starting cleanup process..."
                sh '''
                    # Kill all hanging docker processes (SIGKILL - force kill)
                    echo "Killing hanging docker processes..."
                    pkill -9 -f "docker build" || true
                    pkill -9 -f "docker push" || true
                    pkill -9 -f "docker pull" || true
                    
                    # Stop all running containers from this build
                    docker ps -q --filter "label=jenkins-build=${BUILD_NUMBER}" | xargs -r docker stop || true
                    docker ps -q --filter "label=jenkins-build=${BUILD_NUMBER}" | xargs -r docker rm -f || true
                    
                    # Remove dangling images (untagged)
                    docker image prune -f || true
                    
                    # Remove build cache older than 24h
                    docker builder prune -f --filter "until=24h" || true
                    
                    # Kill any zombie processes
                    ps aux | grep -i docker | grep defunct | awk '{print $2}' | xargs -r kill -9 || true
                    
                    # Logout from Docker Hub
                    docker logout || true
                    
                    echo "Cleanup completed."
                '''
            }
        }
        failure {
            script {
                if (env.CHANGES_DETECTED == 'true') {
                    // Lấy thông tin commit
                    def commitAuthor = sh(returnStdout: true, script: 'git log -1 --pretty=format:"%an"').trim()
                    def commitMessage = sh(returnStdout: true, script: 'git log -1 --pretty=format:"%s"').trim()
                    
                    // Tính duration
                    def duration = currentBuild.durationString.replace(' and counting', '')
                    
                    def message = """
❌ *Build Thất Bại*
📦 Project: vaoluoi-frontend
🔖 Branch: ${env.GIT_BRANCH}
👤 Commit by: ${commitAuthor}
� Commit message: ${commitMessage}
⏱ Duration: ${duration}
🕒 Time: ${new Date().format('dd/MM/yyyy HH:mm:ss')}
🔗 Build URL: ${env.BUILD_URL}
                    """.trim()
                    
                    sh """
                    curl -s -X POST https://api.telegram.org/bot\${TELEGRAM_BOT_TOKEN}/sendMessage \\
                         -d chat_id=\${TELEGRAM_CHAT_ID} \\
                         -d parse_mode=Markdown \\
                         -d text='${message}'
                    """
                }
            }
        }
    }
}